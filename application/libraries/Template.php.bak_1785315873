        if (!$key && isset($_ENV['YOUTUBE_API_KEY'])) {
            $key = $_ENV['YOUTUBE_API_KEY'];
        }
        if (!$key && isset($_SERVER['YOUTUBE_API_KEY'])) {
            $key = $_SERVER['YOUTUBE_API_KEY'];
        }
        if (!$key && function_exists('config_item')) {
